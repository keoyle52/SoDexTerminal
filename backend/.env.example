# SoDEX Terminal Backend — environment variables
# Copy to .env and fill in your values

# Server
PORT=3001

# Gemini AI (Google AI Studio — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# SoSoValue API (https://sosovalue.com)
SOSOVALUE_API_KEY=your_sosovalue_api_key_here

# Telegram Bot (create via @BotFather, then paste the token here)
# This is the SINGLE shared bot all users interact with.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# CORS — set to your frontend origin in production
FRONTEND_URL=http://localhost:5173
